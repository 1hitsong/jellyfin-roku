import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/AnimationControl.bs"
import "pkg:/source/enums/AnimationState.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.librarySection = m.top.findNode("librarySection")
    m.homeContent = m.top.findNode("homeContent")

    if isValid(m.librarySection)
        m.librarySection@.setActive(true)
    end if
end sub

sub OnScreenShown()
    m.scene = m.top.getScene()
    if isValid(m.scene)
        m.overhang = m.scene.findNode("overhang")
        setNodePropertyValue(m.overhang, "isVisible", false)
    end if

    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
    end if
end sub

sub OnScreenHidden()
end sub

function getHomeSection(rootNode as object) as object
    if not isValid(rootNode) then return invalid
    if rootNode.isSameNode(rootNode.focusedChild) then return rootNode
    if not rootNode.hasField("itemComponentName") then return getHomeSection(rootNode.focusedChild)
    return rootNode
end function


' Special handling for key presses on the home screen.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.OK)
        if not isValid(m.scene) then return false

        focusedHomeSection = getHomeSection(m.scene)
        if not isChainValid(focusedHomeSection, "content") then return false

        selectedItem = focusedHomeSection.content.getChild(focusedHomeSection.itemSelected)
        if not isValid(selectedItem) then return false

        m.top.selectedItem = selectedItem
        return true
    end if

    if isStringEqual(key, KeyCode.RIGHT)
        if m.librarySection.isInFocusChain()
            m.librarySection@.setActive(false)
            m.homeContent@.setActive(true)
            m.top.lastFocus = m.homeContent
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.LEFT)
        if m.homeContent.isInFocusChain()
            m.librarySection@.setActive(true)
            m.top.lastFocus = m.librarySection
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.BACK)
        if m.homeContent.isInFocusChain()
            m.librarySection@.setActive(true)
            m.top.lastFocus = m.librarySection
            return true
        end if
    end if

    return false
end function
