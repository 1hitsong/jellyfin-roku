<?xml version="1.0" encoding="utf-8"?>
<component name="Home" extends="JFScreen">
    <children>
        <LayoutGroup
            translation="[50, 50]"
            layoutDirection="horiz"
            horizAlignment="left"
            itemSpacings="[20]">
            <LayoutGroup
                layoutDirection="vert"
                vertAlignment="top"
                itemSpacings="[10]">
                <LibraryNavigation id="librarySection" />
            </LayoutGroup>
            <HomeContent id="homeContent" />
        </LayoutGroup>
    </children>
    <interface>
        <field id="selectedItem" type="node" alwaysNotify="true" />
    </interface>
</component>