<?xml version="1.0" encoding="utf-8"?>

<component name="LibraryNavigation" extends="HomeSection">
    <children>
        <LayoutGroup
            translation="[0, 0]"
            layoutDirection="vert"
            vertAlignment="top"
            itemSpacings="[10]">
            <MarkupList
                id="libraryList"
                itemComponentName="LibraryItem"
                drawFocusFeedback="true"
                focusBitmapUri="pkg:/images/homeItem.png"
                focusFootprintBitmapUri="pkg:/images/transparent.png"
                itemSpacing="[0, 10]"
                itemSize="[300, 50]"
                numRows="16"
                vertFocusAnimationStyle="floatingFocus" />
        </LayoutGroup>
        <Timer id="keypressTimer" duration="1" />
    </children>
</component>