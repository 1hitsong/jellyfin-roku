import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.libraryList = m.top.findNode("libraryList")

    m.LoadLibrariesTask = createObject("roSGNode", "LoadItemsTask")
    renderThreadQueue.AddMessageHandler("librariesLoaded", "loadLibrariesMessageHandler")

    m.keypressTimer = m.top.findNode("keypressTimer")
    m.keypressTimer.observeField("fire", "onKeypressTimerFire")
    m.lastLoadedItem = 0

    loadLibraries()
end sub

sub loadLibraries()
    m.LoadLibrariesTask.control = TaskControl.RUN
end sub

sub loadLibrariesMessageHandler(libraryData, _)
    row = CreateObject("roSGNode", "ContentNode")
    row.appendChildren(libraryData)

    if isValid(m.libraryList)
        m.libraryList.content = row
        m.libraryList.observeField("itemFocused", "onItemFocusedChange")
    end if
end sub

sub onItemFocusedChange()
    stopLoadingSpinner()

    m.keypressTimer.control = "stop"
    m.keypressTimer.control = "start"
end sub

sub onKeypressTimerFire()
    ' Don't change if we aren't changing libraries
    if m.lastLoadedItem = m.libraryList.itemFocused then return

    ' Don't change if library navigation is no longer in focus
    if not m.top.isinFocusChain()
        return
    end if

    renderThreadQueue.PostMessage("changeLibrary", m.libraryList.content.getChild(m.libraryList.itemFocused))
    m.lastLoadedItem = m.libraryList.itemFocused
end sub

sub processCollapse(expanded as boolean)
    m.libraryList.itemSize = expanded ? "[300, 50]" : "[60, 50]"
end sub

sub setActive(value as boolean)
    if isValid(m.libraryList)
        m.libraryList.setfocus(value)
        processCollapse(value)
    end if
end sub
