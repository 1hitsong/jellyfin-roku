import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.newReleasesList = m.top.findNode("newReleasesList")
    m.LoadItemsTask = createObject("roSGNode", "LoadItemsTask")
    renderThreadQueue.AddMessageHandler("newReleasesLoaded", "loadLibrariesMessageHandler")
    m.LoadItemsTask.itemsToLoad = "latestReleases"

    loadItems()
end sub

sub loadItems()
    m.LoadItemsTask.control = TaskControl.RUN
end sub

sub loadLibrariesMessageHandler(data, _)
    m.itemData = data

    row = CreateObject("roSGNode", "ContentNode")
    row.appendChildren(m.itemData)

    if isValid(m.newReleasesList)
        m.newReleasesList.content = row
    end if
end sub

sub setActive(value as boolean)
    if isValid(m.newReleasesList)
        m.newReleasesList.setfocus(value)
    end if
end sub
