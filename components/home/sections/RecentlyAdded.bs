import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.recentlyAddedList = m.top.findNode("recentlyAddedList")
    m.LoadItemsTask = createObject("roSGNode", "LoadItemsTask")
    renderThreadQueue.AddMessageHandler("recentlyAddedLoaded", "loadLibrariesMessageHandler")
    m.LoadItemsTask.itemsToLoad = "allRecentlyAdded"

    loadItems()
end sub

sub loadItems()
    m.LoadItemsTask.control = TaskControl.RUN
end sub

sub loadLibrariesMessageHandler(data, _)
    m.itemData = data

    row = CreateObject("roSGNode", "ContentNode")
    row.appendChildren(m.itemData)

    if isValid(m.recentlyAddedList)
        m.recentlyAddedList.content = row
    end if
end sub

sub setActive(value as boolean)
    if isValid(m.recentlyAddedList)
        m.recentlyAddedList.setfocus(value)
    end if
end sub
